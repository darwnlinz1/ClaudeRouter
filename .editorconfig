root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{py,js,ts,tsx,json,toml,yml,yaml,html,css,svg,md}]
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.ps1]
end_of_line = crlf
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab
