# Safe process-environment reference for the local P0 service.
#
# The application does NOT automatically load .env files. Export these values
# in the launching shell/process supervisor. A real .env is ignored by Git.
# Never put cookies, tokens, API keys, passwords, private keys, account salts,
# or other credentials in this example.

# Security boundary: these are the only accepted values.
ORCH_DEPLOYMENT_MODE=local

# Cookie-backed Web Claude account files. Store credentials as files in this
# ignored directory; do not put cookie values in environment variables.
ORCH_COOKIES_DIR=cookies

# Model and request limits.
ORCH_MODEL=claude-sonnet-5
ORCH_MAX_TOKENS=4096
ORCH_MAX_TURNS=25
ORCH_LLM_MAX_RETRIES=8
ORCH_PROTOCOL_ATTEMPTS_PER_COOKIE=3
ORCH_RATE_LIMIT_COOLDOWN_SECONDS=18000
ORCH_MAX_ACCOUNT_COOLDOWN_SECONDS=86400
ORCH_ACCOUNT_LEASE_TTL_SECONDS=180

# Planning and execution limits.
ORCH_MAX_FILE_CHARS=2000000
ORCH_WORKER_FEEDBACK_MAX_CHARS=1000
ORCH_REVIEWER_FEEDBACK_MAX_CHARS=1200
ORCH_MAX_WORKSTREAMS_PER_MANAGER_SLOT=1
ORCH_AUTO_CONTINUE_MAX_CYCLES=20
ORCH_MAX_MANAGER_WORK_ITEMS=12
ORCH_MAX_FILES_PER_WORK_PACKAGE=12
ORCH_PLANNER_COUNT_RETRIES=2
ORCH_HIERARCHY_MAX_SOURCE_FILES=32
ORCH_HIERARCHY_SOURCE_FILE_CHARS=24000
ORCH_HIERARCHY_DIRECTOR_SOURCE_CHARS=80000
ORCH_HIERARCHY_MANAGER_SOURCE_CHARS=48000
ORCH_MANAGER_RECOVERY_CYCLES=1
ORCH_DIRECTOR_RECOVERY_CYCLES=1
ORCH_TEST_TIMEOUT_SECONDS=300
ORCH_SANDBOX_CANCELLATION_POLL_SECONDS=0.05
ORCH_SCOPE_CLAIM_TIMEOUT_SECONDS=900

# Repository-local redacted journals. Treat their contents as sensitive.
ORCH_AGENT_LOG_DIR=logs/agents

# Retention and in-memory observability limits.
ORCH_EVENT_RETENTION_DAYS=30
ORCH_LOG_RETENTION_DAYS=14
ORCH_ARTIFACT_RETENTION_DAYS=90
ORCH_OBSERVABILITY_RETENTION_DAYS=30
ORCH_MAX_EVENTS_PER_TASK=50000
ORCH_RETENTION_INTERVAL_SECONDS=21600
ORCH_OBSERVABILITY_MAX_RECORDS=2000
ORCH_MODEL_TIMING_MAX_ENTRIES=2048
ORCH_MODEL_TIMING_TTL_SECONDS=3600

# Optional path overrides are intentionally left unset so platform-safe
# defaults under the operator home directory are used:
#   ORCHESTRATOR_DB_PATH       ~/.ai_orchestrator/orchestrator.sqlite3
#   ORCH_ACCOUNT_LEASE_DB      ~/.ai_orchestrator/account_leases.sqlite3
#   ORCH_ARTIFACTS_DIR         ~/.ai_orchestrator/artifacts
#   ORCH_SNAPSHOTS_DIR         ~/.ai_orchestrator/snapshots
#   ORCH_TASKS_FILE            ~/.ai_orchestrator/tasks.json (legacy import)
#
# If overriding a path, export an absolute path in the shell. Do not commit the
# resulting databases, WAL/SHM files, artifacts, snapshots, logs, or backups.
#
# There is deliberately no host override. Start with:
#   python -m orchestrator.cli --port 8000
# which binds to 127.0.0.1.
